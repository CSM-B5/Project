# Copy to .env and edit.  (.env is git-ignored — never commit real secrets)

# ---- Web ----
# Frontend origins allowed by CORS (comma separated). Vite dev server default:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=15

# ---- Database & files ----
DATABASE_URL=sqlite:///./storage/medvision.db
STORAGE_DIR=storage

# ---- Security ----
# Leave blank: a random secret is generated once and saved in storage/.secret_key
# (or set your own:  python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=
ACCESS_TOKEN_MINUTES=480
# Let patients create their own account via POST /api/auth/register
ALLOW_PATIENT_REGISTRATION=true

# ---- First admin account (created at startup if it does not exist) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- DEVELOPMENT ONLY: creates 4 demo users (admin/doctor/radiologist/patient) ----
# Passwords are public (see README). Set to false for anything real.
SEED_DEMO_USERS=true

# ---- Chat / report engine: "mock" (no key needed) or "anthropic" ----
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
