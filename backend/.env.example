# Copy to .env and edit.  (.env is git-ignored — never commit real keys)

# Frontend origins allowed by CORS (comma separated). Vite dev server default:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Max upload size in MB
MAX_UPLOAD_MB=15

# Chat / report engine: "mock" (no key needed) or "anthropic"
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
